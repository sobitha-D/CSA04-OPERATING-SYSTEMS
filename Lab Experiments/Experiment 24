#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main()
{
    int fd;
    char data[100];

    fd = open("file.txt", O_CREAT | O_RDWR, 0666);

    if (fd < 0)
    {
        printf("File open error");
        return 1;
    }

    write(fd, "Hello Operating System", 22);

    lseek(fd, 0, SEEK_SET);

    read(fd, data, 22);
    data[22] = '\0';

    printf("File Content: %s\n", data);

    close(fd);

    printf("File closed successfully");

    return 0;
}

OUTPUT:
File Content: Hello Operating System
File closed successfully
