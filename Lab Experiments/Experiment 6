#include <stdio.h>

int main() {
    int n, bt[10], rt[10], pr[10], i, t = 0, done = 0, hp;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        printf("BT and Priority of P%d: ", i + 1);
        scanf("%d%d", &bt[i], &pr[i]);
        rt[i] = bt[i];
    }

    printf("\nExecution Order: ");

    while(done < n) {
        hp = -1;
        for(i = 0; i < n; i++)
            if(rt[i] > 0 && (hp == -1 || pr[i] < pr[hp]))
                hp = i;

        printf("P%d ", hp + 1);
        rt[hp]--;
        t++;

        if(rt[hp] == 0)
            done++;
    }

    return 0;
}

