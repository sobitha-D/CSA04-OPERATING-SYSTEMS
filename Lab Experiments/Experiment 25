#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd;
    struct stat st;
    DIR *d;
    struct dirent *de;

    fd = open("file.txt", O_CREAT | O_RDWR, 0666);

    fcntl(fd, F_SETFL, O_APPEND);
    write(fd, "Hello\n", 6);

    lseek(fd, 0, SEEK_SET);

    stat("file.txt", &st);
    printf("File Size: %ld bytes\n", st.st_size);

    d = opendir(".");
    printf("Directory Files:\n");

    while ((de = readdir(d)) != NULL)
        printf("%s\n", de->d_name);

    close(fd);
    closedir(d);

    return 0;
}

