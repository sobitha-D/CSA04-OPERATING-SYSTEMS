#include <stdio.h>

int main()
{
    int block[20], process[20];
    int nb, np, i, j;

    printf("Enter number of memory blocks: ");
    scanf("%d", &nb);

    printf("Enter size of memory blocks:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter size of processes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("\nProcess\tSize\tBlock\n");

    for(i = 0; i < np; i++)
    {
        for(j = 0; j < nb; j++)
        {
            if(block[j] >= process[i])
            {
                printf("P%d\t%d\tB%d\n", i + 1, process[i], j + 1);
                block[j] -= process[i];
                break;
            }
        }

        if(j == nb)
            printf("P%d\t%d\tNot Allocated\n", i + 1, process[i]);
    }

    return 0;
}

